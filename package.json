{
  "name": "nusend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply nusend --local",
    "db:migrate:remote": "wrangler d1 migrations apply nusend --remote",
    "key:create": "node scripts/create-api-key.ts",
    "cf-typegen": "wrangler types",
    "format": "oxfmt --write --no-error-on-unmatched-pattern \"**/*.{js,jsx,ts,tsx,mjs,cjs,json,jsonc}\"",
    "format:check": "oxfmt --check --no-error-on-unmatched-pattern \"**/*.{js,jsx,ts,tsx,mjs,cjs,json,jsonc}\"",
    "lint": "oxlint",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "hono": "^4.12.28"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.0",
    "@types/node": "^26.1.0",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.107.0"
  },
  "packageManager": "pnpm@11.9.0"
}
