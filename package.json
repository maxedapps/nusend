{
  "name": "nusend",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "oxfmt --write --no-error-on-unmatched-pattern \"**/*.{js,jsx,ts,tsx,mjs,cjs,json,jsonc}\"",
    "format:check": "oxfmt --check --no-error-on-unmatched-pattern \"**/*.{js,jsx,ts,tsx,mjs,cjs,json,jsonc}\"",
    "lint": "oxlint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "packageManager": "pnpm@11.9.0"
}
