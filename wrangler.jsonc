{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nusend",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-06",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nusend",
      "database_id": "replace-with-d1-database-id",
      "migrations_dir": "migrations",
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "DISPATCHER", "class_name": "Dispatcher" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Dispatcher"] }],
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
  "observability": { "enabled": true },
}
