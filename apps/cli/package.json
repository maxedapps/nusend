{
  "name": "@nusend/cli",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "nusend": "dist/main.js"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @nusend/api-contract build && tsc -p tsconfig.build.json && node scripts/make-bin-executable.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@nusend/api-contract": "workspace:*",
    "effect": "4.0.0-beta.93"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
