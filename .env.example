# Canonical Nusend application runtime inventory.
# Production installs this as /etc/nusend/nusend.env, owned by root with mode
# 0600. Values are visible to Docker administrators. Never commit real secrets.

# Container invariants (Compose forces these values in production).
NODE_ENV=production
NUSEND_HOST=0.0.0.0
NUSEND_PORT=3000
NUSEND_DB_PATH=/var/lib/nusend/nusend.sqlite
# Legacy port fallback used only when NUSEND_PORT is absent.
# PORT=3000

# API authentication (required by api; shared with worker via the common file).
# Generate independent high-entropy values of at least 32 characters.
BETTER_AUTH_SECRET=replace-with-an-independent-random-secret-at-least-32-characters
BETTER_AUTH_URL=https://mail.example.com
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
NUSEND_AUTH_TRUSTED_ORIGINS=https://mail.example.com
NUSEND_API_KEY_HASH_SECRET=replace-with-an-independent-random-secret-at-least-32-characters

# Least-privilege AWS credentials used by SES/SNS operations and sending.
# Prefer a dedicated IAM identity restricted to the required SES/SNS actions.
AWS_ACCESS_KEY_ID=replace-with-aws-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-aws-secret-access-key
# Set only for temporary credentials.
# AWS_SESSION_TOKEN=replace-with-aws-session-token
AWS_REGION=us-east-1

# SES and worker settings. NUSEND_SES_FROM_EMAIL is required by worker.
NUSEND_SES_FROM_EMAIL=sender@example.com
# Optional SES configuration-set names and SNS topic allowlist.
NUSEND_SES_TRANSACTIONAL_CONFIGURATION_SET=
NUSEND_SES_MARKETING_CONFIGURATION_SET=
NUSEND_SES_FEEDBACK_TOPIC_ARNS=
# Optional comma-separated values: open,click.
NUSEND_SES_TRACKING_EVENTS=
NUSEND_SES_TRACKING_CUSTOM_REDIRECT_DOMAIN=
NUSEND_SES_REQUEST_TIMEOUT_MS=30000
NUSEND_SEND_WORKER_LEASE_SECONDS=300
NUSEND_SEND_WORKER_BATCH_SIZE=1
NUSEND_SEND_WORKER_POLL_MS=5000
# Optional stable worker identity; a random identity is generated when unset.
NUSEND_WORKER_ID=

# Public unsubscribe links (required together for production sending).
NUSEND_PUBLIC_BASE_URL=https://mail.example.com
NUSEND_UNSUBSCRIBE_SECRET=replace-with-an-independent-random-secret-at-least-32-characters
# Optional previous secret during a controlled unsubscribe-secret rotation.
NUSEND_UNSUBSCRIBE_PREVIOUS_SECRET=

# Migration operator safety switch. Leave unset; use only for an explicitly
# reviewed destructive rollback command.
# NUSEND_CONFIRM_DESTRUCTIVE_ROLLBACK=1

# Backup credentials are deliberately absent: backup receives only dedicated
# Compose secrets and never inherits this application environment file.
