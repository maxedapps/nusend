# Production environment contract for Docker Compose.
# Copy to `.env` and replace every placeholder. Shell/CI/Infisical may supply the
# same variable names instead; Compose maps only the values listed here.
# Optional: `infisical run -- docker compose up -d --wait`

# Public hostname and ingress mode: direct | cloudflare
NUSEND_DOMAIN=mail.example.com
NUSEND_INGRESS_MODE=direct

# Exact owner reconciled on every API startup.
NUSEND_OWNER_EMAIL=owner@example.com
NUSEND_OWNER_NAME=Owner

# Application secrets and Google OAuth.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
NUSEND_API_KEY_HASH_SECRET=replace-with-another-32-character-secret
NUSEND_UNSUBSCRIBE_SECRET=replace-with-unsubscribe-secret
# Optional only during a controlled unsubscribe secret rotation.
# NUSEND_UNSUBSCRIBE_PREVIOUS_SECRET=

# Application AWS/SES credentials and settings.
AWS_ACCESS_KEY_ID=replace-with-application-aws-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-application-aws-secret-access-key
# Optional temporary application AWS credentials only.
# AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
NUSEND_SES_FROM_EMAIL=sender@example.com
NUSEND_SES_TRANSACTIONAL_CONFIGURATION_SET=transactional-set
# Optional marketing / feedback / tracking values.
# NUSEND_SES_MARKETING_CONFIGURATION_SET=
# NUSEND_SES_FEEDBACK_TOPIC_ARNS=
# NUSEND_SES_TRACKING_EVENTS=
# NUSEND_SES_TRACKING_CUSTOM_REDIRECT_DOMAIN=

# Mandatory encrypted restic backups in R2 (or another S3-compatible restic repo).
# Keep these credentials distinct from the application AWS keys above.
NUSEND_RESTIC_REPOSITORY=s3:https://<accountid>.r2.cloudflarestorage.com/<bucket>/nusend
NUSEND_R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
NUSEND_R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
NUSEND_RESTIC_PASSWORD=replace-with-high-entropy-restic-password
