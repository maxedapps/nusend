# Existing provisioning profile or SSO profile. Never use the Nusend runtime user.
AWS_PROFILE=nusend-provisioner
AWS_REGION=us-east-1

# Public application and SES identity.
NUSEND_DOMAIN=mail.example.com
SES_IDENTITY=example.com
SES_FROM_EMAIL=sender@example.com

# Dedicated resource names.
SES_TRANSACTIONAL_SET=nusend-transactional-prod
SES_MARKETING_SET=nusend-marketing-prod
SES_EVENT_DESTINATION_NAME=nusend-sns
SNS_TOPIC_NAME=nusend-ses-events-prod
SNS_DLQ_NAME=nusend-ses-webhook-dlq
RUNTIME_IAM_USER_NAME=nusend-runtime-prod
RUNTIME_IAM_POLICY_NAME=nusend-runtime
ALARM_NAME_PREFIX=nusend-prod

# true creates and configures the marketing configuration set.
ENABLE_MARKETING=true

# DELIVERY enables end-to-end success validation. Tracking is marketing-only.
ENABLE_DELIVERY_EVENTS=true
TRACKING_EVENTS_JSON='[]'
# Allowed tracking examples: '["OPEN"]', '["CLICK"]', '["OPEN","CLICK"]'

# Optional Route 53 automation. Leave empty for manual DNS.
ROUTE53_HOSTED_ZONE_ID=

# Leave ALARM_ACTION_ARN empty to create a dedicated topic and email subscription.
# Never use the SES feedback topic for alarm notifications.
ALARM_ACTION_ARN=
ALARM_TOPIC_NAME=nusend-ops-alarms-prod
OPS_ALERT_EMAIL=owner@example.com

# SES production-access submission is disabled until explicitly reviewed.
SUBMIT_PRODUCTION_ACCESS_REQUEST=false
SES_MAIL_TYPE=MARKETING
SES_WEBSITE_URL=https://example.com
SES_CONTACT_EMAIL=owner@example.com
SES_USE_CASE_DESCRIPTION='Nusend sends explicitly requested transactional email and consent-based marketing email. Recipient acquisition, bounce/complaint handling, unsubscribe handling, and sending-frequency controls are documented and monitored.'
